# Copy to ~/assembly-erp/.env.production on the Rocky Linux server.
# Never commit the real file. Both database URLs must be the direct Neon
# endpoint and include sslmode=verify-full.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full'
MIGRATION_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full'
V2_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full'

